# Copy to .env (git-ignored). run.bat loads it for a local run (--dotenv, names only are printed); Docker compose reads it from this folder; a real environment variable wins.
# Start-up values only. Page limits, DPI, uploads and storage are settings: change them on the admin page (/admin/);
# a saved value beats .env. Armory cancels a call after 120 s, so tune the page and time limits together.
# Shared with armory and ember_api. Leave empty only for loopback-only use.
INTERNAL_API_TOKEN=
SERVICE_HOST=127.0.0.1
SERVICE_PORT=29402
# Docker only: 0.0.0.0 = reachable on the LAN; 127.0.0.1 = this machine only.
SERVICE_BIND=0.0.0.0
# Unlocks /admin/ (settings, saved model connections, usage). Empty = page off.
SERVICE_ADMIN_PASSWORD=
# The OCR_SGLang_Model address and token are not set here: save a connection on the admin page (/admin/).
