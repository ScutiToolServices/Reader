# Shared with armory and ember_api. Leave empty only for loopback-only use.
INTERNAL_API_TOKEN=
OCR_HOST=127.0.0.1
OCR_PORT=8092
# Docker only: address the published port listens on. 0.0.0.0 = reachable on the LAN; 127.0.0.1 = this machine only.
OCR_BIND=0.0.0.0
# SGLangModel (AI/ModelServices/SGLangModel), the service that runs the model on the GPU, and a token made on its admin page.
OCR_BACKEND_URL=http://127.0.0.1:9210
OCR_BACKEND_TOKEN=
# Armory cancels a call after 120 s, so the page limit and the time limit are tuned together. Nothing has been measured on
# the real GPU host yet: raise OCR_MAX_PAGES and OCR_TIMEOUT_S only after timing a real document.
OCR_MAX_PAGES=30
OCR_TIMEOUT_S=110
OCR_MAX_UPLOAD_MB=50
# Baidu's README renders PDFs at 300 DPI; the model reads 1 tile or many per page (gundam mode).
OCR_DPI=300
OCR_TOKENS_PER_PAGE=8000
OCR_CROP_MODE=1
OCR_TTL_HOURS=24
OCR_QUOTA_MB=200
OCR_CONCURRENCY=1
# Unlocks the settings page at /admin/. Empty = page off. Saved settings win over the values above.
OCR_ADMIN_PASSWORD=
